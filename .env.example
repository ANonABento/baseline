# Copy to .env (repo root) and fill in. Everything has a working default without it.

# LLM fraud analyzer (OpenAI-compatible: Nebius Token Factory, NVIDIA API, Ollama...).
# LLM_PROVIDER=auto uses the OpenAI-compatible provider iff NEBIUS_API_KEY is set,
# otherwise a deterministic keyword-based stub (no network).
LLM_PROVIDER=auto
NEBIUS_API_KEY=
LLM_BASE_URL=https://api.studio.nebius.com/v1/
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_TIMEOUT_S=8

# ---------------------------------------------------------------------------------------
# Real local models need the ml extra:  cd backend && uv sync --extra ml
# (a later plain `uv sync` removes them again; use `uv sync --extra ml` / `make setup ML=1`).
# Any real provider whose deps/weights are missing falls back to its stub with a warning.
# Weights are read from ~/.cache/huggingface; HF_HUB_OFFLINE=1 avoids network checks.
# ---------------------------------------------------------------------------------------

# STT: stub | mlx. In stub mode replay/eval read <clip>.txt sidecar transcripts.
STT_PROVIDER=stub
STT_MODEL=mlx-community/whisper-large-v3-turbo
# STT_MODEL=mlx-community/whisper-small-mlx   # ~2.5x faster (~330 ms vs ~850 ms per utterance)
USE_SIDECAR_TRANSCRIPTS=true

# Segmentation: energy | silero
VAD_PROVIDER=energy
SILERO_THRESHOLD=0.5
VAD_THRESHOLD_DB=-40
VAD_HANGOVER_MS=500

# Speaker verification: stub | ecapa. Enroll first: make enroll-demo  (or scripts/enroll.py)
SPEAKER_PROVIDER=stub
# cosine similarity -> risk: >= ACCEPT => risk <= 0.1, <= REJECT => risk >= 0.9 (recalibrate on real voices)
SPEAKER_ACCEPT_SIM=0.55
SPEAKER_REJECT_SIM=0.30
CUSTOMER_ID=CUST-004217

# Spoof: stub | pretrained (mo-thecreator/Deepfake-audio-detection) | wavlm (scripts/train_spoof.py)
SPOOF_PROVIDER=stub
SPOOF_DEVICE=auto
# SPOOF_LR_PATH=models/spoof_lr.joblib

# Load + warm up real models at server start (~7-15 s once; first MPS/MLX inference is slow)
WARMUP_MODELS=true

# Replay pacing (1.0 = real time)
REPLAY_SPEED=1.0

# Frontend (Vite) overrides, set in frontend/.env.local if needed:
# VITE_WS_URL=ws://localhost:8000/ws/call
# VITE_API_URL=http://localhost:8000

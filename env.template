# Baseline environment template. Copy to .env and fill in the blank keys:   cp env.template .env
# .env is gitignored: never commit it. Names match backend/settings.py (pydantic-settings reads .env)
# plus scripts/generate_synthetic_calls.py.

# ---- ElevenLabs: TTS for the live AI voices AND synthetic training data -------------------------------------
# Key permissions needed: text_to_speech (required), voices_read (listing voices).
# speech_to_text only if you later want ElevenLabs Scribe STT (the key used earlier lacked it).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=kHe5D7QBSu8PKLzFC8Hz
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_PROVIDER=auto

# ---- LLM (fraud analyzer, AI caller personas, and script writer for synthetic calls) ------------------------
# Nebius is the default preset (gpt-oss-120b). Blank NEBIUS_API_KEY = the generator falls back to built-in templates.
NEBIUS_API_KEY=
NVIDIA_API_KEY=
LLM_PROVIDER=auto
CALLER_LLM_PROVIDER=nebius
LLM_MODEL=
LLM_BASE_URL=

# ---- Real models (instead of stubs) -------------------------------------------------------------------------
STT_PROVIDER=mlx
VAD_PROVIDER=silero
SPEAKER_PROVIDER=ecapa
SPOOF_PROVIDER=pretrained
EMOTION_PROVIDER=wavlm

# ---- Hugging Face (public datasets and weights work without it; set for higher rate limits) ----------------
HF_TOKEN=

# ---- Synthetic data generator defaults ----------------------------------------------------------------------
SYNTH_OUT_DIR=data/synthetic
SYNTH_MODEL=eleven_flash_v2_5
SYNTH_CALLS_PER_SCENARIO=6
